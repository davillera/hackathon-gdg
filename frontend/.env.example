# URL de la API FastAPI en Cloud Run. Si se deja vacío, el frontend usa datos de demostración.
NEXT_PUBLIC_API_URL=

# Firebase Auth. Si se dejan vacíos, el acceso se omite (modo demostración).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
