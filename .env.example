# ============================================================
# Configuración general del proyecto (copiar a .env y completar)
# .env NO se sube al repo. Nunca pongas aquí llaves JSON ni contraseñas.
# ============================================================

# --- Google Cloud / BigQuery (datos, backend y script de carga) ---
GCP_PROJECT_ID=
BQ_DATASET=supply_chain
BQ_LOCATION=US
# Ruta a la llave de una Service Account, solo para correr en local. Déjala vacía si usas
# `gcloud auth application-default login`. En Cloud Run no se usa (la cuenta va asociada al servicio).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Backend (FastAPI) ---
# El backend usa GCP_PROJECT_ID. Con GCP_PROJECT_ID vacío responde con datos de demostración.
CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=60

# --- Frontend (Next.js). Las variables NEXT_PUBLIC_* quedan visibles en el navegador ---
# URL de la API. Vacía = datos de demostración.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Firebase Auth (Configuración del proyecto > Tus apps > App web). Vacías = sin inicio de sesión.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Despliegue ---
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_SERVICE=inventario-api
